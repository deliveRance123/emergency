# EmergencyConnect Environment Configuration Example
# Replace with your Neon PostgreSQL Connection String
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Auth sessions (Generate a random 32+ character string)
JWT_SECRET="your-32-character-or-longer-secret-key-goes-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
